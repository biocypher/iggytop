### NEO4j settings ##

# Username and password divided by "/" for Neo4j.
# Every other NEO4J_* variable here becomes a neo4j.conf setting, and Neo4j 5 refuses to start on
# unknown ones, so only add variables that map to real settings.
NEO4J_AUTH=neo4j/neo4jpassword

# create_release.py's "neo4j" output format imports into the default "neo4j" database,
# so no dbms.default_database override or CREATE DATABASE step is needed here.

# Plugins (APOC, GDS) and their procedure/file settings are baked into the image as ENV defaults
# (see the Dockerfile's deploy-stage); set them here only to override those.

# Memory settings for GDS (Neo4j 5 names; "__" becomes a literal "_" in the setting name)
NEO4J_server_memory_heap_initial__size=2G
NEO4J_server_memory_heap_max__size=4G
NEO4J_server_memory_pagecache_size=2G
