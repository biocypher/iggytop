      "@type": "sc:Dataset",
      "name": "TRAIT T-cell Receptor–Antigen Interaction Dataset",
      "description": "A comprehensive dataset of T-cell receptor–antigen interactions integrating receptor and antigen sequences, structures, binding affinities, single-cell evidence, mutations, and therapeutic information.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Wei M, Wu J, Bai S, et al. TRAIT: A Comprehensive Database for T-cell Receptor–antigen Interactions. Genomics, Proteomics & Bioinformatics. 2025;23(3):qzaf033. https://doi.org/10.1093/gpbjnl/qzaf033",
      "creator": [
        {
          "@type": "sc:Person",
          "name": "Mengmeng Wei, Jingcheng Wu, Shengzuo Bai, Yuxuan Zhou, Yichang Chen, Xue Zhang, Wenyi Zhao, Ying Chi"
        }
      ],
      "datePublished": "2025-03-12T00:00:00Z",
      "license": "UNKNOWN",
